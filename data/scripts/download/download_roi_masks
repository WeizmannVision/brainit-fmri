#!/bin/bash
# Download Algonauts ROI masks from Google Drive (subjects 1-8).
#
# Source: https://drive.google.com/drive/folders/1DUf3nGNNFk6YjRjQtZPfAY5N105GoGJb
# Requires: gdown (pip install gdown)
#
# Downloads each file individually (via gdown --folder --json) so a single
# file failure can be retried and skipped without aborting the whole subject.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT_DIR="${OUT_DIR:-${SCRIPT_DIR}/../../nsd_data/roi_masks}"

FOLDERS=(
    "https://drive.google.com/drive/folders/1Ir2akZCj4O_Us6Lu90Ol_ZRAdL26onff"
    "https://drive.google.com/drive/folders/1DfjrnovORU4HiTdFcf7vvf46Eqa_ffKQ"
    "https://drive.google.com/drive/folders/1_5hoJW96sfd66ULAU-ZVdvk9SbjtBzsQ"
    "https://drive.google.com/drive/folders/1WFk5LvjvkK6dktc6NEyQi70iAq7yBt8E"
    "https://drive.google.com/drive/folders/1jthefvkpA38uiN-07x3DChOwcGXIeO_-"
    "https://drive.google.com/drive/folders/1fTbZdzleoZHYVDZv5trkrpcG_2JxornQ"
    "https://drive.google.com/drive/folders/1QJ4gE4aHqzA4c8C7iOHqMS5zxE3sSqK6"
    "https://drive.google.com/drive/folders/17sn7ep2c6qDiBcFf1fNnhEL0sjlc8M30"
)

download_subject() {
    python3 - "$1" "$2" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

url = sys.argv[1]
out_dir = Path(sys.argv[2])


def gdown(*args, capture=False):
    return subprocess.run(["gdown", *args], capture_output=capture, text=True)


def list_files():
    for attempt in range(2):
        result = gdown("--folder", "--json", url, "--quiet", capture=True)
        if result.returncode == 0:
            return json.loads(result.stdout)
        if attempt == 0:
            print("  retrying folder listing...", file=sys.stderr)
    return None


def download_file(file_url, out_path):
    if out_path.exists():
        print(f"  skip (exists): {out_path}")
        return True

    out_path.parent.mkdir(parents=True, exist_ok=True)
    print(f"  {out_path}")

    for attempt in range(2):
        result = gdown(file_url, "-O", str(out_path))
        if result.returncode == 0:
            return True
        if attempt == 0:
            print(f"  retrying {out_path}...", file=sys.stderr)
    return False


files = list_files()
if files is None:
    sys.exit(255)

files = [f for f in files if Path(f["path"]).name.startswith(("lh.all", "rh.all"))]

failed = 0
for item in files:
    rel_path = item["path"]
    local_path = out_dir / Path(rel_path).name
    if download_file(item["url"], local_path):
        print(f"  [SUCCESS] {local_path.name}")
    else:
        print(f"  [FAILED]  {local_path.name}, skipping")
        failed += 1

sys.exit(failed)
PY
}

mkdir -p "${OUT_DIR}"

failed=0

for ((i=1; i<=8; i++)); do
    sub_dir="${OUT_DIR}/sub${i}"
    mkdir -p "${sub_dir}"
    echo "Subject ${i}: ${FOLDERS[i - 1]} -> ${sub_dir}"

    if download_subject "${FOLDERS[i - 1]}" "${sub_dir}"; then
        echo "[SUCCESS] Subject ${i}"
    else
        code=$?
        if [[ "${code}" -eq 255 ]]; then
            echo "[FAILED]  Subject ${i} (could not list folder), skipping"
        else
            echo "[FAILED]  Subject ${i} (${code} file(s) failed)"
        fi
        failed=$((failed + 1))
    fi
    echo
done

if [[ "${failed}" -gt 0 ]]; then
    echo "${failed} subject(s) failed. Files saved under ${OUT_DIR}"
    exit 1
fi

echo "Done. Files saved under ${OUT_DIR}"
